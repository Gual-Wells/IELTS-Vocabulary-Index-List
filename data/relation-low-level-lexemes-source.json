{
  "version": 1,
  "reviewedAt": "2026-09-07",
  "scope": "relation-noise-only",
  "description": "Independent, manually reviewed closed-class and grammatical-noise lexicon. It is not derived from CEFR A1/A2 and never suppresses phrase or usage matches.",
  "groups": [
    {
      "category": "clitic",
      "reason": "Contracted grammatical form without an independent lexical relation.",
      "lexemes": ["'d", "'ll", "'m", "'re", "'s", "'ve", "n't"]
    },
    {
      "category": "article",
      "reason": "Article whose component links overwhelm useful lexical relations.",
      "lexemes": ["a", "an", "the"]
    },
    {
      "category": "pronoun",
      "reason": "Pronoun or pronominal form used primarily for grammatical reference.",
      "lexemes": [
        "i", "me", "mine", "myself", "you", "yours", "yourself", "yourselves",
        "he", "him", "himself", "she", "hers", "herself", "it", "itself",
        "we", "us", "ours", "ourselves", "they", "them", "theirs", "themselves",
        "ones", "oneself", "who", "whom", "whoever", "whose", "which",
        "what", "whatever", "whichever", "somebody", "someone", "something",
        "anybody", "anyone", "anything", "everybody", "everyone", "everything",
        "nobody", "none", "nothing"
      ]
    },
    {
      "category": "determiner",
      "reason": "Determiner whose standalone relation is normally structural rather than lexical.",
      "lexemes": [
        "my", "your", "his", "her", "its", "our", "their", "this", "that", "these",
        "those", "some", "any", "each", "every", "either", "neither", "another",
        "both", "all", "no"
      ]
    },
    {
      "category": "auxiliary",
      "reason": "Auxiliary or modal form; full phrases and context-specific usages remain eligible.",
      "lexemes": [
        "am", "is", "are", "was", "were", "be", "been", "being",
        "have", "has", "had", "having", "do", "does", "did", "done", "doing",
        "can", "could", "may", "might", "must", "shall", "should", "will", "would", "ought"
      ]
    },
    {
      "category": "conjunction",
      "reason": "Coordinator or subordinator whose component links are predominantly grammatical.",
      "lexemes": [
        "and", "or", "but", "nor", "so", "yet", "if", "because", "although", "though",
        "unless", "whereas", "whether", "whenever", "wherever"
      ]
    },
    {
      "category": "preposition-particle",
      "reason": "High-frequency preposition or particle that creates broad component-only relations.",
      "lexemes": [
        "of", "to", "in", "on", "at", "by", "from", "with", "without", "for", "about",
        "against", "among", "around", "as", "before", "behind", "below", "beneath", "beside",
        "between", "beyond", "during", "except", "inside", "into", "near", "off", "onto", "out",
        "outside", "over", "past", "since", "than", "through", "throughout", "toward", "towards",
        "under", "underneath", "until", "up", "upon", "within"
      ]
    },
    {
      "category": "quantifier",
      "reason": "General quantifier whose standalone component relation is rarely useful.",
      "lexemes": ["many", "much", "few", "less", "least", "more", "most", "enough", "several"]
    },
    {
      "category": "number",
      "reason": "Basic cardinal or ordinal form retained as text but removed from relation noise.",
      "lexemes": [
        "zero", "one", "two", "three", "four", "five", "six", "seven", "eight", "nine", "ten",
        "eleven", "twelve", "thirteen", "fourteen", "fifteen", "sixteen", "seventeen", "eighteen",
        "nineteen", "twenty", "thirty", "forty", "fifty", "sixty", "seventy", "eighty", "ninety",
        "hundred", "thousand", "million", "billion", "first", "second", "third", "fourth", "fifth",
        "sixth", "seventh", "eighth", "ninth", "tenth"
      ]
    },
    {
      "category": "discourse-grammar",
      "reason": "High-frequency deictic, polarity, degree, or discourse form with low standalone relation value.",
      "lexemes": [
        "here", "there", "where", "when", "why", "how", "now", "then", "just", "also", "too",
        "very", "quite", "rather", "only", "even", "still", "already", "again", "ever", "never",
        "always", "usually", "often", "sometimes", "maybe", "perhaps", "yes", "not"
      ]
    }
  ]
}
