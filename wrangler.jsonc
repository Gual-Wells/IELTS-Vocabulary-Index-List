{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vix-private",
  "main": "worker/src/index.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "preview_urls": false,
  "access": {
    "dev": {
      "aud": "vix-local",
      "identity": { "email": "local@vix.invalid" }
    }
  },
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "SESSION_OBJECT", "class_name": "SessionObject" },
      { "name": "USAGE_LEDGER", "class_name": "UsageLedger" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["SessionObject", "UsageLedger"] }
  ],
  "vars": {
    "COLLINS_MONTHLY_LIMIT": "1000"
  },
  "keep_vars": true,
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": true }
  }
}
